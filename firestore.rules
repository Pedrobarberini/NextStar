rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function registeredVerifiedUser() {
      return verifiedUser()
        && (
          exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
          || exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        );
    }

    function validAccountDocument(uid, data) {
      return data.keys().hasOnly([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && data.keys().hasAll([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && data.uid == uid
        && data.authProvider in ['password', 'google']
        && data.createdAt == request.time;
    }

    function verifiedGoogleAccount(data) {
      return data.authProvider == 'google'
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && data.termsAcceptedAt == request.time;
    }

    function verifiedPendingPasswordAccount(uid, data) {
      return data.authProvider == 'password'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(
          /databases/$(database)/documents/pendingAccounts/$(uid)
        )
        && get(
          /databases/$(database)/documents/pendingAccounts/$(uid)
        ).data.uid == uid
        && get(
          /databases/$(database)/documents/pendingAccounts/$(uid)
        ).data.authProvider == 'password'
        && data.termsAcceptedAt == get(
          /databases/$(database)/documents/pendingAccounts/$(uid)
        ).data.termsAcceptedAt;
    }

    function owns(uid) {
      return registeredVerifiedUser() && request.auth.uid == uid;
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-z0-9][a-z0-9._]{1,28}[a-z0-9]$');
    }

    function validProfile(uid, data) {
      return data.keys().hasOnly([
          'age', 'bio', 'city', 'club', 'createdAt', 'name', 'photoURL',
          'interestTags', 'plusActive', 'position', 'profileCompleted', 'uid', 'updatedAt', 'username'
        ])
        && data.keys().hasAll([
          'age', 'bio', 'city', 'club', 'createdAt', 'name', 'photoURL',
          'position', 'profileCompleted', 'uid', 'updatedAt', 'username'
        ])
        && data.uid == uid
        && validUsername(data.username)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 80
        && data.bio is string && data.bio.size() >= 10 && data.bio.size() <= 240
        && data.age is int && data.age >= 5 && data.age <= 100
        && data.position is string && data.position.size() >= 2 && data.position.size() <= 40
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.club is string && data.club.size() >= 2 && data.club.size() <= 80
        && (
          !data.keys().hasAny(['interestTags'])
          || (data.interestTags is list && data.interestTags.size() <= 6)
        )
        && data.photoURL is string && data.photoURL.size() <= 2048
        && (!data.keys().hasAny(['plusActive']) || data.plusActive is bool)
        && data.profileCompleted == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function usernameOwnedAfter(uid, username) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == uid;
    }

    function profileUsesUsernameAfter(uid, username) {
      return existsAfter(/databases/$(database)/documents/profiles/$(uid))
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.username == username;
    }

    function oldUsernameReleasedAfter(uid) {
      return request.resource.data.username == resource.data.username
        || (
          !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))
          && usernameOwnedAfter(uid, request.resource.data.username)
        );
    }

    function validPost(postId, data) {
      return data.keys().hasOnly([
          'authorId', 'createdAt', 'description', 'durationMs', 'fileName',
          'fileSize', 'height', 'mediaPath', 'mediaType', 'mentions',
          'mimeType', 'status', 'tags', 'title', 'updatedAt', 'width'
        ])
        && data.keys().hasAll([
          'authorId', 'createdAt', 'description', 'durationMs', 'fileName',
          'fileSize', 'height', 'mediaPath', 'mediaType', 'mentions',
          'mimeType', 'status', 'tags', 'title', 'updatedAt', 'width'
        ])
        && data.authorId is string && data.authorId.size() >= 1
        && data.authorId.size() <= 128
        && data.title is string && data.title.size() >= 4
        && data.title.size() <= 120
        && data.description is string && data.description.size() >= 4
        && data.description.size() <= 2000
        && data.mediaType in ['image', 'video']
        && data.mediaPath == 'posts/' + data.authorId + '/' + postId + '/media'
        && data.mimeType is string && data.mimeType.size() >= 3
        && data.mimeType.size() <= 100
        && data.fileName is string && data.fileName.size() >= 1
        && data.fileName.size() <= 160
        && data.fileSize is int && data.fileSize > 0
        && data.durationMs is int && data.durationMs >= 0
        && data.durationMs <= 120000
        && (
          (
            data.mediaType == 'image'
            && data.fileSize <= 15 * 1024 * 1024
            && data.durationMs == 0
            && data.mimeType.matches('image/(jpeg|png|webp|heic|heif)')
          )
          || (
            data.mediaType == 'video'
            && data.fileSize <= 200 * 1024 * 1024
            && data.mimeType.matches('video/(mp4|quicktime|webm|x-m4v|3gpp)')
          )
        )
        && data.width is int && data.width >= 0 && data.width <= 10000
        && data.height is int && data.height >= 0 && data.height <= 10000
        && data.tags is list && data.tags.size() <= 10
        && data.mentions is list && data.mentions.size() <= 10
        && data.status == 'published'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }


    function validFollow(uid, targetUid, data) {
      return data.keys().hasOnly([
          'createdAt', 'followerUid', 'targetProfileId', 'targetUid'
        ])
        && data.keys().hasAll([
          'createdAt', 'followerUid', 'targetProfileId', 'targetUid'
        ])
        && data.followerUid == uid
        && data.targetUid == targetUid
        && data.targetProfileId == 'profile-' + targetUid
        && uid != targetUid
        && data.createdAt == request.time;
    }

    function validSocialPreferences(uid, data) {
      return data.keys().hasOnly([
          'autoplayEnabled', 'blockedProfileIds', 'deletedAtByContactId',
          'hiddenPlayerIds', 'interestedContentKeys', 'mutedContactIds',
          'mutedContentKeys', 'notificationsEnabled', 'ownerUid',
          'pinnedContactIds', 'reportedPlayerIds', 'updatedAt'
        ])
        && data.keys().hasAll([
          'blockedProfileIds', 'deletedAtByContactId', 'hiddenPlayerIds',
          'interestedContentKeys', 'mutedContactIds', 'mutedContentKeys',
          'ownerUid', 'pinnedContactIds', 'reportedPlayerIds', 'updatedAt'
        ])
        && data.ownerUid == uid
        && (
          !data.keys().hasAny(['autoplayEnabled'])
          || data.autoplayEnabled is bool
        )
        && data.blockedProfileIds is list && data.blockedProfileIds.size() <= 500
        && data.deletedAtByContactId is map
        && data.deletedAtByContactId.size() <= 500
        && data.hiddenPlayerIds is list && data.hiddenPlayerIds.size() <= 500
        && data.interestedContentKeys is list
        && data.interestedContentKeys.size() <= 500
        && data.mutedContactIds is list && data.mutedContactIds.size() <= 500
        && data.mutedContentKeys is list && data.mutedContentKeys.size() <= 500
        && (
          !data.keys().hasAny(['notificationsEnabled'])
          || data.notificationsEnabled is bool
        )
        && data.pinnedContactIds is list && data.pinnedContactIds.size() <= 3
        && data.reportedPlayerIds is list
        && data.reportedPlayerIds.size() <= 500
        && data.updatedAt == request.time;
    }

    function validPostComment(data) {
      return data.keys().hasOnly([
          'authorName', 'authorProfileId', 'authorUserId', 'authorUsername',
          'body', 'createdAt', 'parentCommentId', 'playerId',
          'postId', 'replyToUserId', 'replyToUsername'
        ])
        && data.keys().hasAll([
          'authorName', 'authorProfileId', 'authorUserId', 'authorUsername',
          'body', 'createdAt', 'playerId', 'postId'
        ])
        && data.authorUserId == request.auth.uid
        && data.authorProfileId == 'profile-' + request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.authorUsername is string && data.authorUsername.size() >= 3
        && data.authorUsername.size() <= 30
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1000
        && data.playerId is string && data.playerId.size() >= 1
        && data.playerId.size() <= 128
        && data.postId is string && data.postId.size() >= 1
        && data.postId.size() <= 128
        && (
          data.playerId == data.postId
          || data.playerId == 'approved-' + data.postId
        )
        && (!('parentCommentId' in data)
          || (data.parentCommentId is string
            && data.parentCommentId.size() >= 1
            && data.parentCommentId.size() <= 128))
        && (!('replyToUserId' in data)
          || (data.replyToUserId is string
            && data.replyToUserId.size() >= 1
            && data.replyToUserId.size() <= 128))
        && (!('replyToUsername' in data)
          || (data.replyToUsername is string
            && data.replyToUsername.size() >= 1
            && data.replyToUsername.size() <= 30))
        && data.createdAt == request.time;
    }

    match /accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if verifiedUser()
        && request.auth.uid == uid
        && validAccountDocument(uid, request.resource.data)
        && (
          verifiedGoogleAccount(request.resource.data)
          || verifiedPendingPasswordAccount(uid, request.resource.data)
        );
      allow update, delete: if false;
    }

    match /pendingAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == false
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && request.resource.data.keys().hasAll([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.authProvider == 'password'
        && request.resource.data.createdAt == request.time
        && request.resource.data.termsAcceptedAt == request.time;
      allow update: if false;
      allow delete: if verifiedUser()
        && request.auth.uid == uid
        && existsAfter(
          /databases/$(database)/documents/accounts/$(uid)
        )
        && getAfter(
          /databases/$(database)/documents/accounts/$(uid)
        ).data.authProvider == 'password'
        && getAfter(
          /databases/$(database)/documents/accounts/$(uid)
        ).data.termsAcceptedAt == resource.data.termsAcceptedAt;
    }

    match /profiles/{uid} {
      allow get, list: if registeredVerifiedUser();
      allow create: if owns(uid)
        && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['plusActive'])
          || request.resource.data.plusActive == false)
        && usernameOwnedAfter(uid, request.resource.data.username);
      allow update: if owns(uid)
        && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plusActive'])
        && usernameOwnedAfter(uid, request.resource.data.username)
        && oldUsernameReleasedAfter(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if registeredVerifiedUser();
      allow list: if false;
      allow create: if registeredVerifiedUser()
        && validUsername(username)
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['createdAt', 'uid'])
        && request.resource.data.keys().hasAll(['createdAt', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && profileUsesUsernameAfter(request.auth.uid, username);
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.uid == request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.username != username
        && usernameOwnedAfter(
          request.auth.uid,
          getAfter(
            /databases/$(database)/documents/profiles/$(request.auth.uid)
          ).data.username
        );
    }

    match /posts/{postId} {
      allow get, list: if registeredVerifiedUser();
      allow create: if registeredVerifiedUser()
        && request.resource.data.authorId == request.auth.uid
        && validPost(postId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.authorId == request.auth.uid;
    }

    match /profileMedia/{uid} {
      allow get, list: if registeredVerifiedUser();
      allow create, update, delete: if false;
    }

    match /postEngagement/{playerId} {
      allow get, list: if registeredVerifiedUser();
      allow create, update, delete: if false;
    }

    match /userPostLikes/{uid}/posts/{playerId} {
      allow get, list: if owns(uid);
      allow create, update, delete: if false;
    }

    match /userPostViews/{uid}/posts/{playerId} {
      allow get, list: if owns(uid);
      allow create, update, delete: if false;
    }

    match /directMessages/{messageId} {
      allow get, list: if registeredVerifiedUser()
        && (
          resource.data.senderUserId == request.auth.uid
          || resource.data.recipientUserId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if registeredVerifiedUser()
        && resource.data.recipientUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow get, list: if registeredVerifiedUser();
      allow create: if registeredVerifiedUser()
        && followId == request.auth.uid + '_' + request.resource.data.targetUid
        && validFollow(
          request.auth.uid,
          request.resource.data.targetUid,
          request.resource.data
        )
        && exists(
          /databases/$(database)/documents/profiles/$(request.resource.data.targetUid)
        );
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.followerUid == request.auth.uid;
    }

    match /socialPreferences/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid)
        && validSocialPreferences(uid, request.resource.data);
      allow delete: if false;
    }

    match /subscriptions/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /postComments/{commentId} {
      allow get, list: if registeredVerifiedUser();
      allow create: if registeredVerifiedUser()
        && validPostComment(request.resource.data)
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.name == request.resource.data.authorName
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.username == request.resource.data.authorUsername
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        )
        && get(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        ).data.status == 'published';
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.authorUserId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
