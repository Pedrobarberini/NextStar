rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function registeredVerifiedUser() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function owns(uid) {
      return registeredVerifiedUser() && request.auth.uid == uid;
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-z0-9][a-z0-9._]{1,28}[a-z0-9]$');
    }

    function validProfile(uid, data) {
      return data.keys().hasOnly([
          'age', 'bio', 'city', 'club', 'createdAt', 'name', 'photoURL',
          'position', 'profileCompleted', 'uid', 'updatedAt', 'username'
        ])
        && data.keys().hasAll([
          'age', 'bio', 'city', 'club', 'createdAt', 'name', 'photoURL',
          'position', 'profileCompleted', 'uid', 'updatedAt', 'username'
        ])
        && data.uid == uid
        && validUsername(data.username)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 80
        && data.bio is string && data.bio.size() >= 10 && data.bio.size() <= 240
        && data.age is int && data.age >= 5 && data.age <= 100
        && data.position is string && data.position.size() >= 2 && data.position.size() <= 40
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.club is string && data.club.size() >= 2 && data.club.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.profileCompleted == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function usernameOwnedAfter(uid, username) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == uid;
    }

    function profileUsesUsernameAfter(uid, username) {
      return existsAfter(/databases/$(database)/documents/profiles/$(uid))
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.username == username;
    }

    function oldUsernameReleasedAfter(uid) {
      return request.resource.data.username == resource.data.username
        || (
          !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))
          && usernameOwnedAfter(uid, request.resource.data.username)
        );
    }

    function validPost(postId, data) {
      return data.keys().hasOnly([
          'authorId', 'createdAt', 'description', 'durationMs', 'fileName',
          'fileSize', 'height', 'mediaPath', 'mediaType', 'mentions',
          'mimeType', 'status', 'tags', 'title', 'updatedAt', 'width'
        ])
        && data.keys().hasAll([
          'authorId', 'createdAt', 'description', 'durationMs', 'fileName',
          'fileSize', 'height', 'mediaPath', 'mediaType', 'mentions',
          'mimeType', 'status', 'tags', 'title', 'updatedAt', 'width'
        ])
        && data.authorId is string && data.authorId.size() >= 1
        && data.authorId.size() <= 128
        && data.title is string && data.title.size() >= 4
        && data.title.size() <= 120
        && data.description is string && data.description.size() >= 4
        && data.description.size() <= 2000
        && data.mediaType in ['image', 'video']
        && data.mediaPath == 'posts/' + data.authorId + '/' + postId + '/media'
        && data.mimeType is string && data.mimeType.size() >= 3
        && data.mimeType.size() <= 100
        && data.fileName is string && data.fileName.size() >= 1
        && data.fileName.size() <= 160
        && data.fileSize is int && data.fileSize > 0
        && data.durationMs is int && data.durationMs >= 0
        && data.durationMs <= 120000
        && (
          (
            data.mediaType == 'image'
            && data.fileSize <= 15 * 1024 * 1024
            && data.durationMs == 0
            && data.mimeType.matches('image/(jpeg|png|webp|heic|heif)')
          )
          || (
            data.mediaType == 'video'
            && data.fileSize <= 200 * 1024 * 1024
            && data.mimeType.matches('video/(mp4|quicktime|webm|x-m4v|3gpp)')
          )
        )
        && data.width is int && data.width >= 0 && data.width <= 10000
        && data.height is int && data.height >= 0 && data.height <= 10000
        && data.tags is list && data.tags.size() <= 10
        && data.mentions is list && data.mentions.size() <= 10
        && data.status == 'published'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validProfileMedia(uid, data) {
      return data.keys().hasOnly([
          'avatarPath', 'avatarURL', 'createdAt', 'cropScale', 'focusX',
          'focusY', 'sourceHeight', 'sourceWidth', 'uid', 'updatedAt'
        ])
        && data.keys().hasAll([
          'avatarPath', 'avatarURL', 'createdAt', 'cropScale', 'focusX',
          'focusY', 'sourceHeight', 'sourceWidth', 'uid', 'updatedAt'
        ])
        && data.uid == uid
        && data.avatarPath == 'avatars/' + uid + '/profile'
        && data.avatarURL is string && data.avatarURL.size() >= 1
        && data.avatarURL.size() <= 2048
        && (data.cropScale is int || data.cropScale is float)
        && data.cropScale >= 0.3 && data.cropScale <= 1
        && (data.focusX is int || data.focusX is float)
        && data.focusX >= 0 && data.focusX <= 100
        && (data.focusY is int || data.focusY is float)
        && data.focusY >= 0 && data.focusY <= 100
        && data.sourceHeight is int && data.sourceHeight > 0
        && data.sourceHeight <= 10000
        && data.sourceWidth is int && data.sourceWidth > 0
        && data.sourceWidth <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && request.resource.data.keys().hasAll([
          'authProvider', 'createdAt', 'termsAcceptedAt', 'uid'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.authProvider in ['password', 'google', 'apple']
        && request.resource.data.createdAt == request.time
        && request.resource.data.termsAcceptedAt == request.time;
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow get, list: if registeredVerifiedUser();
      allow create: if owns(uid)
        && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && usernameOwnedAfter(uid, request.resource.data.username);
      allow update: if owns(uid)
        && validProfile(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && usernameOwnedAfter(uid, request.resource.data.username)
        && oldUsernameReleasedAfter(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if registeredVerifiedUser();
      allow list: if false;
      allow create: if registeredVerifiedUser()
        && validUsername(username)
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['createdAt', 'uid'])
        && request.resource.data.keys().hasAll(['createdAt', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && profileUsesUsernameAfter(request.auth.uid, username);
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.uid == request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.username != username
        && usernameOwnedAfter(
          request.auth.uid,
          getAfter(
            /databases/$(database)/documents/profiles/$(request.auth.uid)
          ).data.username
        );
    }

    match /posts/{postId} {
      allow get, list: if registeredVerifiedUser();
      allow create: if registeredVerifiedUser()
        && request.resource.data.authorId == request.auth.uid
        && validPost(postId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if registeredVerifiedUser()
        && resource.data.authorId == request.auth.uid;
    }

    match /profileMedia/{uid} {
      allow get, list: if registeredVerifiedUser();
      allow create: if owns(uid)
        && validProfileMedia(uid, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid)
        && validProfileMedia(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}