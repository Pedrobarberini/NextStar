{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://xolot.com.br",
          "https://www.xolot.com.br",
          "https://xolot.web.app",
          "https://xolot.firebaseapp.com",
          "http://localhost:8081",
          "http://localhost:19006"
        ],
        "methods": ["PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
